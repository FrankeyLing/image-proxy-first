#!/bin/sh
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
"$dir/../bin/linux-x64/image-proxy" "$@"
result=$?
[ "$result" -eq 78 ] || exit "$result"
if [ -x "$dir/../.venv/bin/python" ]; then
    exec "$dir/../.venv/bin/python" "$dir/proxy_fallback.py" "$@"
fi
exec python3 "$dir/proxy_fallback.py" "$@"
